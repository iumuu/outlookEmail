# =============================================================================
# Flask 基础配置
# =============================================================================

# 必须设置！使用以下命令生成随机串：
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# 登录密码（默认：admin123，首次启动后会自动哈希存储）
# 建议首次启动后立即通过 Web 界面修改为强密码（至少8位）
LOGIN_PASSWORD=admin123

# =============================================================================
# 应用运行时
# =============================================================================
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# 全局日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（默认 INFO）
# 默认 INFO 会输出出站 [代理] 详情（拉信 / Token 刷新 / 自动授权；密码已打码）
# 批量刷新或生产环境觉得吵时，设为 WARNING 可降噪关闭 [代理] 与大部分 INFO 日志
# LOG_LEVEL=WARNING

# 数据库路径
DATABASE_PATH=data/outlook_accounts.db

# IMAP 超时（秒）
IMAP_TIMEOUT=45

# 邮件列表整体获取超时（秒），也可在系统设置中调整
MAIL_FETCH_OVERALL_TIMEOUT=120

# =============================================================================
# AI 邮件翻译（可选：三项必填，否则禁用；密钥只保留在服务端）
# =============================================================================
# 服务根地址自动补 /v1/chat/completions；/v1 地址自动补 /chat/completions
# AI_TRANSLATION_BASE_URL=https://api.openai.com/v1
# AI_TRANSLATION_API_KEY=replace-with-your-provider-key
# AI_TRANSLATION_MODEL=gpt-4o-mini
# AI_TRANSLATION_TIMEOUT_SECONDS=45  # 5–90 秒，默认 45
# 配置与隐私说明见 docs/ai-email-translation.md

# =============================================================================
# 临时邮箱服务
# =============================================================================
GPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=gpt-test

DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# =============================================================================
# OAuth2 配置（可选，不填使用默认值）
# =============================================================================
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_REDIRECT_URI=http://localhost:8080

# =============================================================================
# Docker 自更新（可选，仅 Docker 部署时使用）
# =============================================================================
# 启用后需要将宿主 Docker socket 挂载到容器：
#   - /var/run/docker.sock:/var/run/docker.sock
# DOCKER_UPDATE_ENABLED=true
# DOCKER_UPDATE_CONTAINER=outlook-mail
